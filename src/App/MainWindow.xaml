<Window x:Class="SevenZipper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="7Zipper" Style="{StaticResource AppWindow}"
        Width="1060" Height="690" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragEnter="OnFilesDragEnter" DragOver="OnFilesDragOver" DragLeave="OnFilesDragLeave"
        Drop="OnFilesDropped" PreviewKeyDown="OnShortcut"
        Closing="OnClosing">
    <Grid x:Name="LayoutRoot" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <WrapPanel x:Name="Actions">
                <Button x:Name="CreateButton" Click="OnCreate" Style="{StaticResource PrimaryAction}" Margin="0,0,6,0"
                        ToolTip="새 압축 (Ctrl+N)" AutomationProperties.Name="새 압축">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,7,0" />
                        <TextBlock Text="새 압축" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenButton" Click="OnOpen" Style="{StaticResource Action}" Margin="0,0,6,0"
                        ToolTip="압축 파일 열기 (Ctrl+O)" AutomationProperties.Name="압축 파일 열기">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,7,0" />
                        <TextBlock Text="열기" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExtractButton" Click="OnExtract" Style="{StaticResource Action}" Margin="0,0,6,0"
                        ToolTip="압축 풀기 (Ctrl+E)" AutomationProperties.Name="압축 풀기">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,7,0" />
                        <TextBlock Text="압축 풀기" />
                    </StackPanel>
                </Button>
                <Button x:Name="TestButton" Click="OnTest" Style="{StaticResource Action}"
                        ToolTip="압축 파일 무결성 검사 (Ctrl+T)" AutomationProperties.Name="무결성 검사">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,7,0" />
                        <TextBlock Text="무결성 검사" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource AppPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="12,7,12,6" LastChildFill="True">
                    <TextBlock x:Name="ArchiveName" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Style="{StaticResource Muted}" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"
                               MaxWidth="300" />
                    <TextBlock Text="압축 파일 내용" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid x:Name="Navigation" Grid.Row="1" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" MaxWidth="224" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <Button x:Name="RootButton" Click="OnRoot" Style="{StaticResource NavAction}" Margin="0,0,5,0"
                                ToolTip="최상위 폴더" AutomationProperties.Name="최상위 폴더">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" />
                        </Button>
                        <Button x:Name="UpButton" Click="OnUp" Style="{StaticResource NavAction}"
                                ToolTip="상위 폴더 (Backspace / Alt+↑)" AutomationProperties.Name="상위 폴더">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" />
                        </Button>
                    </StackPanel>
                    <TextBox Grid.Column="1" x:Name="FolderBox" Text="/" IsReadOnly="True"
                             Style="{StaticResource Field}" AutomationProperties.Name="현재 압축 폴더" />
                    <Grid Grid.Column="2" Margin="10,0,0,0">
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Style="{StaticResource Field}"
                                 Padding="29,4,28,4" AutomationProperties.Name="압축 파일 전체 검색"
                                 ToolTip="압축 파일 전체 검색 (Ctrl+F)" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="8,0,0,0"
                                   HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="이름 또는 경로 검색" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="29,0,28,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="SearchClearButton" Click="OnClearSearch" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="검색어 지우기 (Esc)"
                                AutomationProperties.Name="검색어 지우기">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ClearButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE711;" />
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="EntryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                              RowHeight="30" ColumnHeaderHeight="34" RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#272C32"
                              BorderThickness="0,1" BorderBrush="{StaticResource LineBrush}"
                              Background="{StaticResource EditorBrush}" RowBackground="{StaticResource EditorBrush}"
                              AlternatingRowBackground="#1A1D23" Foreground="{StaticResource TextBrush}"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              ScrollViewer.CanContentScroll="True"
                              AutomationProperties.Name="압축 항목 목록"
                              SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick"
                              PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseLeftButtonUp="OnRowMouseUp"
                              PreviewMouseRightButtonDown="OnRowContextClick"
                              PreviewMouseMove="OnRowMouseMove" PreviewKeyDown="OnGridKeyDown">
                        <DataGrid.Resources>
                            <Style x:Key="CellText" TargetType="TextBlock">
                                <Setter Property="Margin" Value="10,0,6,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="10,0,6,0" />
                                <Setter Property="Background" Value="#252930" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="NameColumn" Header="이름" Width="*" MinWidth="160" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,0,6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Style="{StaticResource Icon}" />
                                            <TextBlock Grid.Column="1" ToolTip="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Name}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                                <Setter Property="Text" Value="{Binding Path}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="크기" Width="97" MinWidth="74" Binding="{Binding SizeText}"
                                                SortMemberPath="Size" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="압축 방식" Width="126" MinWidth="84" Binding="{Binding Method}"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="수정 시각" Width="144" MinWidth="122" Binding="{Binding ModifiedText}"
                                                SortMemberPath="Modified" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="EntryMenu" Opened="OnEntryMenuOpened">
                                <MenuItem x:Name="OpenFolderMenu" Header="폴더 열기" Click="OnOpenFolder" />
                                <MenuItem x:Name="ExtractSelectionMenu" Header="선택 항목 압축 풀기" Click="OnExtract" />
                                <Separator />
                                <MenuItem x:Name="CopyPathMenu" Header="경로 복사" Click="OnCopyPath" />
                                <MenuItem x:Name="SelectAllMenu" Header="전체 선택 (Ctrl+A)" Click="OnSelectAll" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <Border x:Name="EmptyState" Margin="1,34,1,1" Background="{StaticResource EditorBrush}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,7">
                            <TextBlock x:Name="EmptyTitle" Text="압축 파일을 열어 보세요"
                                       Style="{StaticResource SectionTitle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="EmptyHint" Margin="0,5,0,0" Style="{StaticResource Muted}"
                                       Text="압축 파일을 끌어 놓거나 열기를 선택하세요." TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="CountText" Grid.Row="3" Text="0개 항목"
                           Margin="12,4" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource AppPanel}" Margin="0,10,0,0" Padding="12,7">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="취소" Click="OnCancel"
                            Style="{StaticResource Action}" IsEnabled="False" MinHeight="30" Padding="12,4" Margin="6,0,0,0" />
                    <ToggleButton x:Name="LogToggle" DockPanel.Dock="Right" Content="작업 기록" Margin="6,0,0,0"
                                  Style="{StaticResource ActionToggle}" ToolTip="작업 기록을 펼치거나 접습니다." Checked="OnLogOpened" />
                    <Button x:Name="OpenResultButton" DockPanel.Dock="Right" Content="폴더 열기" Click="OnOpenResult"
                            Style="{StaticResource Action}" Visibility="Collapsed" MinHeight="30" Padding="10,4" Margin="10,0,0,0"
                            ToolTip="결과 파일 또는 폴더를 파일 탐색기에서 엽니다." AutomationProperties.Name="결과 폴더 열기" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TaskTitle" Text="준비됨" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="TaskDetail" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,7,0,0">
                    <TextBlock x:Name="ProgressCountText" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="OverallProgressText" Text="전체 진행률" Style="{StaticResource Muted}" />
                </DockPanel>
                <ProgressBar x:Name="JobProgress" Height="6" Margin="0,4,0,1" Minimum="0" Maximum="100"
                             Background="{StaticResource InputBrush}" Foreground="{StaticResource FocusBrush}"
                             AutomationProperties.Name="전체 진행률" />
                <StackPanel x:Name="CurrentProgressPanel" Margin="0,5,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="CurrentProgressText" Style="{StaticResource Muted}" />
                    <ProgressBar x:Name="CurrentJobProgress" Height="4" Margin="0,3,0,1" Minimum="0" Maximum="100"
                                 Background="{StaticResource InputBrush}" Foreground="{StaticResource MutedBrush}"
                                 AutomationProperties.Name="현재 압축 파일 진행률" />
                </StackPanel>
                <ListBox x:Name="LogList" MaxHeight="92" Margin="0,5,0,0"
                         Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BooleanToVisibility}}"
                         Background="{StaticResource EditorBrush}" BorderBrush="{StaticResource LineBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource MutedBrush}"
                         AutomationProperties.Name="작업 기록 목록">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Border x:Name="DropOverlay" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#CC15181D" BorderBrush="{StaticResource FocusBrush}" BorderThickness="2" CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <TextBlock Style="{StaticResource Icon}" FontSize="36" Text="&#xE896;"
                           Foreground="{StaticResource FocusBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="DropOverlayTitle" Text="여기에 놓으세요" Style="{StaticResource Heading}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="DropOverlayHint" Text="" Style="{StaticResource Muted}"
                           Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
